      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[0].sentence
      value: "Haha, je suis arriv\xE9 avant toi. Va sur le c\xF4t\xE9, j'ai besoin
        de toi pour m'avertir si il y a un danger. Je te fais... confiance."
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[1].sentence
      value: "Ne bouge pas tant que la police n'est pas l\xE0. Si jamais je me fais
        prendre, prends l'argent et part avec la voiture stationn\xE9e devant le
        parc."
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[2].sentence
      value: "Reste sur le c\xF4t\xE9, et garde un oeil..."
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
