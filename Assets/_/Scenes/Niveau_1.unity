    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[0].sentence
      value: "Ok, je vois que tu as quand m\xEAme un certain courage. Tiens, voici
        quelques dollars pour te f\xE9liciter."
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[1].sentence
      value: "Maintenant, tu vois la madame avec sa bo\xEEte l\xE0-bas? Je serais
        vraiment curieux de savoir ce qu'il y a dedans."
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[2].sentence
      value: "Si tu me ram\xE8nes ce myst\xE9rieux colis, je te donne un bon 20 dollars.
        Fais \xE7a discr\xE8tement!"
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[0].skipDelayTime
