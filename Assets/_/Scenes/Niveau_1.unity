    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[0].sentence
      value: "Oh wow, une tablette de derni\xE8re g\xE9n\xE9ration, \xE7a \xE7a vaut
        de l'or. Tiens, voici ton argent."
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[1].sentence
      value: "Il y a pas grand-monde qui tra\xEEne dans le parc aujourd'hui. Je pense
        pas que j'ai autre chose \xE0 te faire faire."
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[2].sentence
      value: "Je te sugg\xE8re de prendre le taxi et d'aller plut\xF4t dans les ruelles
        en soir\xE9e si tu veux vraiment plus d'argent. Allez, bonne chance."
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[0].skipDelayTime
