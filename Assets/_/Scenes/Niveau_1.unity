      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: audioSource
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: triggerState
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[0].sentence
      value: "T'es qui toi? Je pense pas que tu parles \xE0 la bonne personne \xE0
        moins que tu cherches vraiment de l'argent."
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[1].sentence
      value: "Ah ouais, tu veux jouer dans la cour des grands? \xC9coute-moi bien,
        il va falloir faire tes preuves."
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[2].sentence
      value: "J'ai une mission pour toi. C'est rien d'incroyable, mais \xE7a va te
        tester sous pression."
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[3].sentence
      value: "Tu vois le policier l\xE0-bas qui parle avec la madame? Va lui voler
        son d\xEEner sur la table, mais \xE9coute-moi bien..."
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[4].sentence
      value: "\xC9vite de passer dans son champ de vision avec son beigne dans les
        mains, sinon \xE7a va mal finir."
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[5].sentence
      value: Allez, bouge!
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[0].skipDelayTime
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
      propertyPath: sentences.Array.data[0].dialogueCharacter
      value: 
      objectReference: {fileID: 11400000, guid: 8592339280b820a40a9958deadd47f97, type: 2}
    - target: {fileID: 8557568673631317014, guid: cc0b3ff4467379548b7df5f7e83dd6a2, type: 3}
